# ============================================================
# MultiCamera Capture System — .gitignore
# ============================================================

# --- Python ---
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
venv/
.venv/
env/
.env
*.egg-info/
dist/
build/
*.egg

# --- Datasets (may contain personal/biometric images) ---
Datasets/
Datasets_*/

# --- Android build outputs ---
android_app/.gradle/
android_app/build/
android_app/app/build/
android_app/local.properties
android_app/.idea/
android_app/**/*.iml

# --- Gradle caches ---
.gradle/
gradle-app.setting

# --- Python app caches / local config ---
laptop_app/__pycache__/
tools/__pycache__/
tests/__pycache__/
integration/__pycache__/

# --- Logs ---
*.log
logs/

# --- OS files ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDE / Editor ---
.idea/
*.iws
*.ipr
.vscode/
*.swp
*.swo

# --- Temporary / scratch ---
*.tmp
*.bak
scratch/
