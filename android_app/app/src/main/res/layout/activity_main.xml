<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MultiCamera Node"
        android:textColor="#2196F3"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="3D Gaussian Splatting Remote Capture"
        android:textColor="#757575"
        android:textSize="12sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="#2C2C2C" />

    <!-- Configuration Fields -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Camera Identifier"
        android:textColor="#B0BEC5"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etCameraId"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:background="#1E1E1E"
        android:hint="camera_01"
        android:padding="10dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#546E7A"
        android:textSize="15sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Laptop Server IP Address"
        android:textColor="#B0BEC5"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etServerHost"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:background="#1E1E1E"
        android:hint="192.168.1.6"
        android:inputType="textUri"
        android:padding="10dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#546E7A"
        android:textSize="15sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Server Port"
        android:textColor="#B0BEC5"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etServerPort"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:background="#1E1E1E"
        android:hint="8000"
        android:inputType="number"
        android:padding="10dp"
        android:text="8000"
        android:textColor="#FFFFFF"
        android:textColorHint="#546E7A"
        android:textSize="15sp" />

    <!-- Action Buttons -->
    <Button
        android:id="@+id/btnConnect"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="#2196F3"
        android:text="@string/connect"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

    <!-- Status Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="#1E1E1E"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_disconnected"
            android:textColor="#FF5252"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvBattery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Battery: --%"
            android:textColor="#B0BEC5"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvCameraReady"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Camera Sensor: Initializing..."
            android:textColor="#B0BEC5"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Activity Log View -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Log Activity"
        android:textColor="#757575"
        android:textSize="12sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:background="#181818">

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:padding="10dp"
            android:textColor="#A5D6A7"
            android:textSize="11sp" />
    </ScrollView>

</LinearLayout>
